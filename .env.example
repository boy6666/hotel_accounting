# ============================================================
# 酒店记账系统 · Docker Compose 环境变量模板
# 用法：cp .env.example .env  然后修改以下值（.env 已被 .gitignore 排除，不会入库）
# ============================================================

# 对外访问端口（前端 nginx）。公网部署建议 80，或由宿主机 nginx/cloudflared 反代
APP_PORT=8080

# MySQL root 密码（后端连接同一密码；部署时务必修改）
MYSQL_ROOT_PASSWORD=change-me-root

# JWT 签名密钥（部署时务必改为 ≥32 位随机串）
JWT_SECRET=please-change-me-to-a-random-32-char-secret!!

# DeepSeek API Key（可选：不填则 AI 解读自动降级为纯统计，不影响其它功能）
DEEPSEEK_API_KEY=
